# Copy this file to .env and adjust as needed.

# Where the FastAPI backend is running. Your teammate confirmed it's on
# localhost for now — swap this to the Render URL once it's deployed.
VITE_API_BASE_URL=http://localhost:8000

# Only needed if the backend ends up requiring a client-side API key header
# (separate from the Gemini key the backend already holds server-side).
# Leave blank unless your teammate says the frontend needs to send one.
# VITE_API_KEY=
